{
  "expo": {
    "name": "On Bade",
    "slug": "je-bade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jebade",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.oriverse.jebade",
      "associatedDomains": [
        "applinks:www.onbade.com",
        "applinks:onbade.com"
      ],
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1919",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oriverse.jebade",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.onbade.com",
              "pathPrefix": "/b/"
            },
            {
              "scheme": "https",
              "host": "onbade.com",
              "pathPrefix": "/b/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1919",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#9810e6"
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "On Bade a besoin d'accéder à tes photos pour ajouter une image à un bading ou créer un sticker.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "On Bade utilise le micro pour enregistrer tes notes vocales en commentaire, uniquement pendant que tu restes appuyé sur le bouton micro."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "backgroundColor": "#1a1919"
  }
}
